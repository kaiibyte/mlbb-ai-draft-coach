
{
  "version": 2,
  "builds": [
    {
      "src": "api/draft.js",
      "use": "@vercel/node"
    },
    {
      "src": "test.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/draft.js"
    },
    {
      "src": "/(.*)",
      "dest": "/test.html"
    }
  ]
}
